# Copy this file to ".env" and fill in the real value.
# ".env" is git-ignored, so your secret never gets pushed to GitHub.
# Get the connection string from: Azure Portal -> your Storage Account
#   -> Security + networking -> Access keys -> Connection string.

AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
